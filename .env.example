# Database
# Local SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# AWS RDS PostgreSQL (Recommended):
DATABASE_URL=postgresql+asyncpg://postgres:<YOUR_PASSWORD>@<YOUR_RDS_ENDPOINT>:5432/ai_hr_db

# Security & JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:5173

# AI & LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB & Storage
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=resumes
LOCAL_RESUME_STORAGE_DIR=./data/resumes

# AWS S3 (Optional future file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

